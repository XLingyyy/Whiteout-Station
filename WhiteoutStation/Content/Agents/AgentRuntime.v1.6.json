{
  "schema_version": 9,
  "runtime_version": "1.6.0",
  "protocol_version": "natural_roleplay_v6",
  "prompt_mode": "canonical_intent_then_natural_expression",
  "max_sentences": 3,
  "max_line_chars": 320,
  "max_output_tokens": 1000,
  "temperature": 0.45,
  "top_k_knowledge": 10,
  "max_session_turns": 10,
  "provider_name": "deepseek",
  "model": "deepseek-v4-flash",
  "endpoint": "https://api.deepseek.com",
  "timeout_seconds": 10,
  "llm_enabled": false,
  "transport": "openai_chat_completions",
  "credential_policy": "Settings UI credentials are process-memory only. Environment and ignored LocalConfig credentials remain supported for development.",
  "fallback_policy": "No commit on unverified expression. Pure controls are locally authored; offline choices remain available by user selection.",
  "notes": "Complete Chinese npc_line, locally filtered current state and history, critical full-text verification before atomic commit.",
  "intent_timeout_seconds": 3,
  "expression_timeout_seconds": 7,
  "intent_max_output_tokens": 1600,
  "max_message_output_tokens": 3840,
  "max_intents_per_message": 6,
  "max_calls_per_turn": 2,
  "verification_max_output_tokens": 700,
  "normal_deadline_seconds": 10,
  "critical_deadline_seconds": 15,
  "dialogue_quota_scope": "per_npc_per_run",
  "count_roleplay_clarification": true,
  "count_pure_confirmation": false,
  "normal_request_limit": 2,
  "critical_request_limit": 3,
  "auto_rewrite_enabled": false
}
